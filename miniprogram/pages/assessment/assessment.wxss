.report-page {
  padding-top: 28rpx;
}

.report-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-radius: 22rpx 22rpx 0 0;
  background: linear-gradient(135deg, #20bf65 0%, #07a348 100%);
  color: #ffffff;
}

.report-name {
  display: block;
  font-size: 32rpx;
  font-weight: 850;
}

.report-date {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 23rpx;
}

.medal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: #d9f7e4;
  color: #07a348;
  font-size: 34rpx;
}

.result-card,
.score-card,
.suggest-card {
  padding: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(23, 33, 43, 0.06);
}

.result-card {
  border-radius: 0 0 22rpx 22rpx;
}

.score-card,
.suggest-card {
  margin-top: 22rpx;
  border-radius: 22rpx;
}

.section-label {
  display: block;
  color: #17212b;
  font-size: 26rpx;
  font-weight: 850;
}

.result-title {
  display: block;
  margin-top: 18rpx;
  color: #07a348;
  font-size: 34rpx;
  font-weight: 900;
  text-align: center;
}

.result-copy {
  display: block;
  margin-top: 10rpx;
  color: #07a348;
  font-size: 24rpx;
  text-align: center;
}

.score-row {
  display: grid;
  grid-template-columns: 112rpx 1fr 70rpx;
  align-items: center;
  gap: 16rpx;
  margin-top: 22rpx;
}

.score-name {
  color: #44515d;
  font-size: 24rpx;
}

.score-track {
  height: 14rpx;
  overflow: hidden;
  border-radius: 10rpx;
  background: #edf1ef;
}

.score-fill {
  height: 100%;
  border-radius: 10rpx;
  background: #3b9df8;
}

.score-fill.orange {
  background: #f79009;
}

.score-fill.green {
  background: #20bf65;
}

.score-fill.purple {
  background: #875bf7;
}

.score-value {
  color: #17212b;
  font-size: 23rpx;
  text-align: right;
}

.suggest-copy {
  display: block;
  margin-top: 14rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.52;
}

.suggest-banner {
  display: block;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #eaf8ef;
  color: #07a348;
  font-size: 25rpx;
  font-weight: 800;
  text-align: center;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.action-tile {
  min-height: 154rpx;
  padding: 18rpx 12rpx;
  border-radius: 20rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 10rpx 28rpx rgba(23, 33, 43, 0.06);
}

.action-icon {
  display: block;
  font-size: 34rpx;
}

.action-title {
  display: block;
  margin-top: 8rpx;
  color: #17212b;
  font-size: 24rpx;
  font-weight: 850;
}

.action-copy {
  display: block;
  margin-top: 6rpx;
  color: #8a95a3;
  font-size: 20rpx;
}

