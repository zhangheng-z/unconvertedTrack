<view class="page-shell report-page">
  <view class="report-head">
    <view>
      <text class="report-name">语文能力测评报告</text>
      <text class="report-date">测评时间：2024-05-20</text>
    </view>
    <view class="medal">★</view>
  </view>

  <view class="result-card">
    <text class="section-label">测评结果</text>
    <text class="result-title">识字阅读基础偏弱</text>
    <text class="result-copy">建议先进行基础提升训练</text>
  </view>

  <view class="score-card">
    <text class="section-label">能力表现</text>
    <view wx:for="{{scores}}" wx:key="name" class="score-row">
      <text class="score-name">{{item.name}}</text>
      <view class="score-track">
        <view class="score-fill {{item.level}}" style="width: {{item.score}}%;"></view>
      </view>
      <text class="score-value">{{item.score}}分</text>
    </view>
  </view>

  <view class="suggest-card">
    <text class="section-label">建议</text>
    <text class="suggest-copy">孩子当前主要问题集中在识字积累和阅读理解，建议先通过系统训练打好基础。</text>
    <text class="suggest-banner">建议先完成 7 天基础训练，再进行提升</text>
  </view>

  <view class="action-grid">
    <view class="action-tile green">
      <text class="action-icon">📄</text>
      <text class="action-title">领取方案</text>
      <text class="action-copy">获取训练计划</text>
    </view>
    <view class="action-tile blue">
      <text class="action-icon">👩</text>
      <text class="action-title">预约老师</text>
      <text class="action-copy">1对1解读</text>
    </view>
    <view class="action-tile orange" bindtap="goCamp">
      <text class="action-icon">🔥</text>
      <text class="action-title">加入训练营</text>
      <text class="action-copy">7天弱项提升</text>
    </view>
  </view>
</view>

