.content-card {
  display: flex;
  gap: 20rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(23, 33, 43, 0.06);
}

.content-card + .content-card {
  margin-top: 18rpx;
}

.cover-box {
  width: 132rpx;
  height: 156rpx;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 18rpx;
  background: #f4f6f5;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-fallback {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 100%;
  height: 100%;
  padding: 14rpx;
  background: linear-gradient(160deg, #ffe7ea 0%, #fff6e6 100%);
}

.cover-fallback.video {
  background: linear-gradient(160deg, #eaf8ef 0%, #dff7f2 100%);
}

.cover-fallback.assessment {
  background: linear-gradient(160deg, #fff2d2 0%, #ffe2d8 100%);
}

.cover-fallback.camp {
  background: linear-gradient(160deg, #eaf8ef 0%, #dfeaff 100%);
}

.cover-type {
  align-self: flex-start;
  min-height: 34rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: #f04438;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 850;
  line-height: 34rpx;
}

.cover-name {
  color: #17212b;
  font-size: 22rpx;
  font-weight: 850;
  line-height: 1.25;
}

.card-body {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
  padding: 4rpx 0;
}

.title {
  display: block;
  color: #17212b;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.32;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
  padding-right: 8rpx;
}

.tag {
  min-height: 34rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: #eaf8ef;
  color: #07a348;
  font-size: 20rpx;
  line-height: 34rpx;
}

.tag.blue {
  background: #e8f2ff;
  color: #2775cf;
}

.tag.warm {
  background: #fff2d2;
  color: #b46a00;
}

.tag.red {
  background: #ffe9e7;
  color: #f04438;
}

.stats-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
  color: #8a95a3;
  font-size: 22rpx;
  line-height: 1.35;
}

.claim-button {
  align-self: flex-end;
  width: 240rpx;
  min-height: 48rpx;
  margin-top: 12rpx;
  padding: 0 18rpx;
  border-radius: 24rpx;
  background: #07a348;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 750;
  line-height: 48rpx;
}

.claim-button.claimable {
  background: #07a348;
  color: #ffffff;
}

.claim-button.claimed {
  background: #eaf8ef;
  color: #07a348;
}

.claim-button.locked {
  background: #f79009;
  color: #ffffff;
}
